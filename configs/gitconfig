[user]
    name = Filip Nemec
    email = nemecfi99@gmail.com

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = current

[core]
    excludesFile = ~/.gitignore_global

[color]
    ui = auto

[alias]
    st = status -sb
    co = checkout
    br = branch
    lg = log --graph --oneline --decorate --all
    unstage = reset HEAD --
    last = log -1 HEAD
